+/**
+ * Whether a closed terminal socket is tried again (Dolphin's patch).
+ *
+ * A socket that never opened is retried, as before. One that was live and
+ * then closed is retried only when the host asks (`retryAfterDrop`) and the
+ * close was not one the backend chose: 1000 means the session ended (tmux
+ * attach exited) and 1008 means it was refused. Anything else — 1006 from a
+ * dropped tunnel or a slept laptop, 1012 from a helper restart — is a drop.
+ */
+export function shouldRetryAfterClose(reachedOpen, code, retryAfterDrop) {
+    if (!reachedOpen)
+        return true;
+    return Boolean(retryAfterDrop) && code !== 1000 && code !== 1008;
+}
